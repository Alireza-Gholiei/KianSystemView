@inherits BaseComponent
@layout LoginLayout
@attribute [AllowAnonymous]
@page "/ForgotPassword"

@using Despro.Blazor.Layout.Components.Dimmers

<div>
    <div style="justify-content: center;align-items: center;min-height: 100vh;display: flex;position: relative;">
        <div class="form-container">
            <img src="image-icon/logo.png" class="logo-pulse" alt="" />
            <div class="fade-in pt-5">
                <h2 class="mb-5 text-center text-4xl font-extrabold tracking-tight">فراموشی رمز عبور</h2>
                <Dimmer Active="@IsSubmit" Text="لطفا منتطر بمانید...">
                    <EditForm OnValidSubmit="@SubmitPassword" FormName="LoginForm" EditContext="EditContext">
                        <DataAnnotationsValidator />
                        <div class="input-container">
                            <label for="login-username">شماره تماس</label>
                            <InputText id="login-username"
                                       type="tel"
                                       DisplayName="شماره تماس"
                                       disabled="@(ShowForgotPassword || ShowRequestCode)"
                                       @bind-Value="ForgotPasswordDto.PhoneNumber"
                                       class="input-icon"
                                       placeholder="09121001000" />
                            <ValidationMessage For="@(() => ForgotPasswordDto.PhoneNumber)" class="error-message" />
                        </div>
                        @if (!ShowForgotPassword)
                        {
                            @if (!ShowRequestCode)
                            {
                                <button type="button" @onclick="RequestCode" class="btn-glow">
                                    📩 درخواست کد تائید
                                </button>
                            }
                            else
                            {
                                <div class="space-y-3">
                                    <div class="input-container">
                                        <label for="login-password">کد تائید</label>
                                        <InputText id="login-password"
                                                   @bind-Value="ForgotPasswordDto.TotpCode"
                                                   class="input-icon"
                                                   placeholder="کد تائید" />
                                        <ValidationMessage For="@(() => ForgotPasswordDto.TotpCode)" class="error-message" />
                                    </div>

                                    @if (TimerSeconds > 0)
                                    {
                                        <p class="mt-2 text-center text-sm text-gray-500">
                                            ارسال مجدد کد تا
                                            <span class="font-semibold text-indigo-600">@TimerSeconds</span>
                                            ثانیه دیگر
                                        </p>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                @onclick="RequestCode"
                                                class="w-full rounded-xl bg-blue-300 py-2 font-medium text-gray-700 transition-all duration-200 hover:bg-blue-400">
                                            🔁 ارسال مجدد کد
                                        </button>
                                    }

                                    <button type="button"
                                            @onclick="@VerifyTotp"
                                            class="btn-glow">
                                        تائید کد
                                    </button>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="input-container">
                                <label for="login-password">رمز عبور</label>
                                <InputText id="login-password"
                                           type="@(ShowLoginPassword ? "text" : "password")"
                                           @bind-Value="ForgotPasswordDto.Password"
                                           class="input-icon"
                                           placeholder="رمز عبور خود را وارد کنید" />
                                <svg @onclick="() => ShowLoginPassword = !ShowLoginPassword" class="toggle-password" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                </svg>
                                <ValidationMessage For="@(() => ForgotPasswordDto.Password)" class="error-message" />
                            </div>
                            <div class="input-container">
                                <label for="login-password">تکرار رمز عبور</label>
                                <InputText id="login-password"
                                           type="@(ShowLoginPasswordConfirm ? "text" : "password")"
                                           @bind-Value="ForgotPasswordDto.ConfirmPassword"
                                           class="input-icon"
                                           placeholder="رمز عبور خود را وارد کنید" />
                                <svg @onclick="() => ShowLoginPasswordConfirm = !ShowLoginPasswordConfirm" class="toggle-password" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                </svg>
                                <ValidationMessage For="@(() => ForgotPasswordDto.ConfirmPassword)" class="error-message" />
                            </div>

                            <button type="submit" class="btn-glow">تغییر رمز</button>
                        }
                        <button type="button" class="mt-4 text-blue-400" @onclick="@(() => NavigationManager.NavigateTo("/Login"))">وارد شدن</button>
                    </EditForm>
                </Dimmer>
            </div>
        </div>
    </div>
</div>