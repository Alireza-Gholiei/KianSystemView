@attribute [StreamRendering]
@inherits BaseComponent

<Card StatusTop="BaseColor.Primary">
    <CardBody>
        <Form Model="@EmergencyNumberModel" OnValidSubmit="Submit">
            <Row>
                <RowCol Md="4">
                    <label class="form-label">کدملی</label>
                    <InputText class="form-control" @bind-Value="@EmployeModel.NationalCode" disabled></InputText>
                </RowCol>
                <RowCol Md="4">
                    <label class="form-label">نام</label>
                    <InputText class="form-control" @bind-Value="@EmployeModel.FirstName" disabled></InputText>
                </RowCol>
                <RowCol Md="4">
                    <label class="form-label">نام خانوادگی</label>
                    <InputText class="form-control" @bind-Value="@EmployeModel.LastName" disabled></InputText>
                </RowCol>
            </Row>
            <Row>
                @foreach (var i in EmergencyNumberModel)
                {
                    <RowCol Md="3">
                        <label class="form-label">عنوان</label>
                        <InputText class="form-control" @bind-Value="@i.Name" placeholder="پدر"></InputText>
                        <ValidationMessage For="(() => i.Name)"></ValidationMessage>
                        <br />
                        <label class="form-label">شماره تماس</label>
                        <InputText class="form-control" @bind-Value="@i.PhoneNumber"></InputText>
                        <ValidationControl For="(() => i.PhoneNumber)"></ValidationControl>
                        <br />
                        <Button Text="حذف" @onclick="@(e => RemoveRow(i))"></Button>
                    </RowCol>
                }
            </Row>
            <Row>
                <Button Text="افزودن" @onclick="AddNewRow"></Button>
            </Row>
        </Form>
    </CardBody>
</Card>