@page "/Employe/EmployeBind"

@attribute [StreamRendering]
@inherits BaseComponent
@using Services.Models.EmployeDtos.Employe

<Table Item="GetMinorEmployeDto" @bind-Items="_employeDtos" OnBindGrid=@OnBind>
    <HeaderTemplate>
        <strong>لیست سربازان</strong>
    </HeaderTemplate>

    <ChildContent>
        <Column Item="GetMinorEmployeDto" Property="e => e.FirstName" Title="نام" Searchable Sortable />
        <Column Item="GetMinorEmployeDto" Property="e => e.LastName" Title="نام خانوادگی" Searchable Sortable />
        <Column Item="GetMinorEmployeDto" Property="e => e.NationalCode" Title="کدملی" Searchable Sortable />
        <Column Item="GetMinorEmployeDto" Property="e => e.DateBirth" Title="تاریخ تولد"
                SearchExpression='(dto, s) => dto.DateBirth.ToString("yyyy/MM/dd").Contains(s)'
                Searchable Sortable>
            <Template>
                @context.DateBirth.ToString("yyyy/MM/dd")
            </Template>
        </Column>
        <Column Item="GetMinorEmployeDto" Property='e => e.DayDispatch' Title="تاریخ اعزم"
                SearchExpression='(dto, s) => dto.DayDispatch.ToString("yyyy/MM/dd").Contains(s)'
                Searchable Sortable>
            <Template>
                @context.DayDispatch.ToString("yyyy/MM/dd")
            </Template>
        </Column>
        <Column Item="GetMinorEmployeDto" Title="عملیات">
            <Template>
                <ButtonList>
                    <Dropdown>
                        <ChildContent>
                            <Button BackgroundColor="BaseColor.Orange" Type="ButtonType.Button" Text="عملیات" IsDropdown>
                            </Button>
                        </ChildContent>

                        <DropdownTemplate>
                            <DropdownMenu>
                                <DropdownItem OnClick="() => AddComplementEmploye(context.Id)">افزودن اطلاعات تکمیلی</DropdownItem>
                                <DropdownItem OnClick="() => EditComplementEmploye(context.Id)">ویرایش اطلاعات تکمیلی</DropdownItem>
                                <DropdownItem OnClick="() => AddServiceStatus(context.Id)">افزودن/ویرایش وضعیت خدمتی</DropdownItem>
                            </DropdownMenu>
                        </DropdownTemplate>
                    </Dropdown>
                </ButtonList>
            </Template>
        </Column>
    </ChildContent>
</Table>