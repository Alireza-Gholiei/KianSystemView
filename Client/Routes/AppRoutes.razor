@using Client.Components
<CustomErrorBoundary>
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <SecureRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
                <Authorizing>
                    <Lodding />
                </Authorizing>
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </SecureRouteView>
        </Found>
        <NotFound>
            <RedirectToNotFound />
        </NotFound>
    </Router>
</CustomErrorBoundary>